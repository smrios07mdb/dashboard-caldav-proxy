# Copy to .env.local for local `vercel dev`. Real values are set in Vercel
# project settings — NEVER commit real secrets. Placeholders only below.

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — server-only, bypasses RLS. Set in Vercel only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWKS endpoint for verifying Supabase-signed JWTs (ES256). Derived from SUPABASE_URL.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# 32-byte base64 key for AES-GCM wrapping of the iCloud app-specific password.
# Generate with: openssl rand -base64 32
CALDAV_ENCRYPTION_KEY=your-base64-32-byte-key

# Comma-separated CORS origins. Scheme + host ONLY (no path, no trailing slash).
ALLOWED_ORIGINS=https://your-gh-username.github.io,http://localhost:5173
